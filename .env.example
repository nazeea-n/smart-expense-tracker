# Copy this file to .env and update your MySQL details
SECRET_KEY=replace-with-a-long-random-secret
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_expense_tracker
FLASK_DEBUG=true

# Email for the "Forgot password" link (optional).
# For Gmail: turn on 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords and paste it below.
# If you leave these empty, the reset link is printed in the terminal instead.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
